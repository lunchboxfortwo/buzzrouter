[Unit]
Description=Deploy BuzzRouter from the main branch
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=lunchbox
Group=lunchbox
Environment=BUZZROUTER_CONFIG_DIR=/etc/buzzrouter
Environment=BUZZROUTER_DATA_DIR=/var/lib/buzzrouter
Environment=BUZZROUTER_ENV_FILE=/etc/buzzrouter/runtime.env
Environment=BUZZROUTER_SOURCE_DIR=/opt/buzzrouter/source
ExecStart=/opt/buzzrouter/source/deploy/self-host/deploy.sh

[Install]
WantedBy=multi-user.target
