{
  "name": "buzzrouter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/connect"
  ],
  "scripts": {
    "admin": "node --import tsx scripts/signed-request.ts",
    "build": "next build",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "dev": "next dev",
    "presence": "node --import tsx scripts/presence.ts",
    "discovery:add": "node --import tsx scripts/add-reviewed-candidate.ts",
    "discovery:buzzdir": "node --import tsx scripts/run-buzzdir-source.ts",
    "discovery:doctor": "node --import tsx scripts/discovery-doctor.ts",
    "discovery:github": "node --import tsx scripts/run-github-source.ts",
    "discovery:github:audit-invites": "node --import tsx scripts/audit-github-invites.ts",
    "discovery:github:verify-invite": "node --import tsx scripts/verify-github-invite-harvest.ts",
    "discovery:nip66": "node --import tsx scripts/run-nip66-source.ts",
    "discovery:x": "node --import tsx scripts/run-x-source.ts",
    "discovery:reconcile": "node --import tsx scripts/reconcile-discovery-sources.ts",
    "discovery:rollup": "node --import tsx scripts/run-reliability-rollup.ts",
    "discovery:seed": "node --import tsx scripts/seed-reviewed-candidates.ts",
    "discovery:status": "node --import tsx scripts/discovery-status.ts",
    "funnel:status": "node --import tsx scripts/funnel-status.ts",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worker": "node --import tsx src/worker.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "ipaddr.js": "^2.2.0",
    "next": "16.2.12",
    "nostr-tools": "^2.24.1",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "24.10.1",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
