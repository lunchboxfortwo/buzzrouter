[Unit]
Description=BuzzRouter GitHub Actions deployment runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=buzzrouter-runner
Group=buzzrouter-runner
WorkingDirectory=/opt/buzzrouter-actions-runner
Environment=HOME=/var/lib/buzzrouter-actions-runner
ExecStart=/opt/buzzrouter-actions-runner/run.sh
Restart=always
RestartSec=5
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
UMask=0077

CapabilityBoundingSet=CAP_AUDIT_WRITE CAP_SETGID CAP_SETUID
DevicePolicy=closed
InaccessiblePaths=-/etc/buzzrouter
InaccessiblePaths=-/home
InaccessiblePaths=-/opt/buzzrouter/bin
InaccessiblePaths=-/opt/buzzrouter/source
InaccessiblePaths=-/root
InaccessiblePaths=-/run/docker.sock
InaccessiblePaths=-/var/lib/buzzrouter
LockPersonality=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/opt/buzzrouter-actions-runner
ReadWritePaths=/var/lib/buzzrouter-actions-runner
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
